# Store and check out text files with LF line endings on every OS, so Windows
# checkouts don't show files as modified just because of CRLF/LF.
* text=auto eol=lf

# Binary files: never touch their bytes
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
