    "articles:check": "node scripts/articles-check.mjs",
    "i18n:notes": "node scripts/translation-notes.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "jsonld:check": "node scripts/jsonld-check.mjs",
    "hreflang:check": "node scripts/hreflang-check.mjs",
    "csp:check": "node scripts/csp-check.mjs",
    "lang-url:check": "node scripts/lang-url-check.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "node-html-parser": "^6.1.13",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
