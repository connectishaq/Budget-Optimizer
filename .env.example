# Copy this file to .env and fill in your values, then run `npm run build`.

# Your live domain (no trailing slash). Used for the canonical tag, og:url,
# sitemap.xml and the Sitemap line in robots.txt.
SITE_URL=https://www.your-domain.com

# Google AdSense publisher ID (ca-pub-...). Leave empty to hide all ad slots.
VITE_ADSENSE_CLIENT=
# Ad unit slot IDs from your AdSense dashboard (optional; empty = auto ads in that slot).
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_INARTICLE=
VITE_ADSENSE_SLOT_BOTTOM=

# Public contact email shown in the footer Contact section.
VITE_CONTACT_EMAIL=
