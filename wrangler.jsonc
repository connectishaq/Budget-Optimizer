{
  "name": "spendmath",
  "compatibility_date": "2026-10-01",
  // Plain static site: no Worker script, so requests don't count against the Worker limit.
  // www -> https://spendmath.com and http -> https are a Redirect Rule and
  // "Always Use HTTPS" in the Cloudflare dashboard.
  "assets": {
    // Built by `npm run build`
    "directory": "./dist",
    // Missing addresses get dist/404.html with a 404 status
    "not_found_handling": "404-page",
    // Default trailing-slash handling ("auto-trailing-slash"): /about -> /about/
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "spendmath.com", "custom_domain": true },
    { "pattern": "www.spendmath.com", "custom_domain": true }
  ]
}
