    {
      "key": "healthPremium",
      "label": "Health insurance premium",
      "group": "care",
      "need": true,
      "help": "What you pay each month for health insurance, including the amount taken from your paycheck for an employer plan or a Marketplace plan after any tax credit.",
      "ranges": {
        "single": {
          "value": [
            80,
            200
          ],
          "verify": true,
          "note": "Built around the KFF 2025 average worker contribution for single coverage ($1,440 a year, about $120 a month); spread is an estimate."
        },
        "suburban": {
          "value": [
            350,
            800
          ],
          "verify": true,
          "note": "Built around the KFF 2025 average worker contribution for family coverage ($6,850 a year, about $570 a month); spread is an estimate."
        },
        "youngpro": {
          "value": [
            100,
            350
          ],
          "verify": true,
          "note": "Between KFF single and family worker contributions (employee + spouse is not in our source); estimate."
        }
      }
    }
