  "localTips": [
    {
      "id": "us-open-enrollment",
      "pool": "healthPremium",
      "title": "Compare health plans at open enrollment",
      "why": "Employer and Marketplace plans change prices every year, and the default is often to roll over into the same plan.",
      "tips": [
        "At open enrollment, compare the premium plus the deductible you realistically expect to pay, not the premium alone.",
        "If you are both covered at work, check whether one family plan or two separate plans costs less.",
        "If you buy on HealthCare.gov or a state Marketplace, update your income: you may qualify for a bigger tax credit."
      ],
      "pct": {
        "value": 0.1,
        "verify": true,
        "note": "Assumed saving from switching plans; estimate."
      },
      "effort": "Easy"
    }
